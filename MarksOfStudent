class Student
{
float mark1,mark2,total,avg;
void mark(float m1,float m2)
  {
	mark1=m1;
	mark2=m2;
  }
void marks()
{
	total=mark1+mark2;
	avg=total/2;
	System.out.println("the total marks="+total);
	System.out.println("the avg="+avg);
  }
}
class MarksOfStudent
{
public static void main(String args[])
  {
	Student s1=new Student();
	Student s2=new Student();
	s1.mark(50,20);
	s1.marks();	
	s2.mark(60,40);
	s2.marks();
  }
}
