class Student
{
String name;
int age;
Student()
{
this("tanuja",20);
}
Student(String n,int a)
{
name=n;
age=a;
}
void display()
{
System.out.println("Name:"+name+",age"+age);
}
}
class ConstructorThis
{
public static void main(String arg[])
{
Student s1=new Student();
s1.display();
