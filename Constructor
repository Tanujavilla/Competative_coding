class Student
{
String name;
int age;
Student()
{
name="unknown";
age=0;
}
Student(String n,int a)
{
name=n;
age=a;
}
void display()
{
System.out.println("Name:"+name+ "age"+age);
}
}
public class Constructor
{
public static void main(String arg[])
{
Student s1=new Student();
s1.display();
Student s2=new Student("tanuja",20);
s2.display();
}
}
